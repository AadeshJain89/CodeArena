POSTGRES_USER=codearena_user
POSTGRES_PASSWORD=codearena_password
POSTGRES_DB=codearena_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

ENVIRONMENT=development
SECRET_KEY=change_this_secret_key_in_production_32_bytes_min
JWT_SECRET_KEY=change_this_jwt_secret_key_in_production_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Code Execution Security Limits
CODE_EXECUTION_TIMEOUT_SECONDS=5.0
CODE_EXECUTION_MEMORY_LIMIT_MB=128
CODE_EXECUTION_CPU_LIMIT=1.0
CODE_EXECUTION_PIDS_LIMIT=64
CODE_EXECUTION_MAX_OUTPUT_BYTES=65536
CODE_EXECUTION_MAX_SOURCE_BYTES=65536
PYTHON_DOCKER_IMAGE=python:3.12-alpine
CPP_DOCKER_IMAGE=gcc:latest
